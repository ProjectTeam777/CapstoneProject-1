import yfinance as yf
import pandas as pd
from sklearn.preprocessing import MinMaxScaler
import numpy as np
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
import matplotlib.pyplot as plt
from sklearn.metrics import mean_squared_error

from pytrends.request import TrendReq
import time

# Step 1: Download SPY data
spy_data = yf.download('SPY', start='2014-01-07', end='2024-11-07')

# Step 2: Preprocess the data
data = spy_data['Close'].values.reshape(-1, 1)
scaler = MinMaxScaler(feature_range=(0, 1))
scaled_data = scaler.fit_transform(data)

# Create sequences
def create_sequences(data, time_step=5):
    X, y = [], []
    for i in range(len(data) - time_step - 1):
        X.append(data[i:(i + time_step), 0])
        y.append(data[i + time_step, 0])
    return np.array(X), np.array(y)

time_step = 5  # using 5 days to predict the next day
X, y = create_sequences(scaled_data, time_step)
X = X.reshape(X.shape[0], X.shape[1], 1)

# Use full data for training
X_full, y_full = create_sequences(scaled_data, time_step)
X_full = X_full.reshape(X_full.shape[0], X_full.shape[1], 1)

# Step 3: Build the LSTM model
model = Sequential()
model.add(LSTM(50, return_sequences=True, input_shape=(X_full.shape[1], 1)))
model.add(Dropout(0.2))
model.add(LSTM(50, return_sequences=False))
model.add(Dropout(0.2))
model.add(Dense(1))  # Output layer
model.compile(optimizer='adam', loss='mean_squared_error')

# Step 4: Train the model on the entire dataset
model.fit(X_full, y_full, epochs=50, batch_size=32)

# Step 5: Use the model to predict prices for the entire dataset
predicted_prices_full = model.predict(X_full)
predicted_prices_full = scaler.inverse_transform(predicted_prices_full)
actual_prices_full = scaler.inverse_transform(scaled_data[time_step:])

# Ensure lengths match
min_length = min(len(predicted_prices_full), len(actual_prices_full), len(spy_data.index[time_step:]))
predicted_prices_full = predicted_prices_full[:min_length]
actual_prices_full = actual_prices_full[:min_length]
date_range = spy_data.index[time_step:][:min_length]

# Step 6: Create a DataFrame for the full prediction period
full_results_df = pd.DataFrame({
    'Actual Prices': actual_prices_full.flatten(),
    'Predicted Prices': predicted_prices_full.flatten(),
    'Date': date_range
})

# Step 7: Calculate Actual and Predicted Trend
actual_trend = ['N/A']
for i in range(1, len(actual_prices_full)):
    if actual_prices_full[i] > actual_prices_full[i - 1]:
        actual_trend.append('Uptrend')
    else:
        actual_trend.append('Downtrend')

predicted_trend = ['N/A']
for i in range(1, len(predicted_prices_full)):
    if predicted_prices_full[i] > predicted_prices_full[i - 1]:
        predicted_trend.append('Uptrend')
    else:
        predicted_trend.append('Downtrend')

# Step 8: Store trend values in ml_trend_indicators
ml_trend_indicators = pd.DataFrame({
    'Date': date_range,
    'Actual Prices': actual_prices_full.flatten(),
    'Predicted Prices': predicted_prices_full.flatten(),
    'Actual Trend': actual_trend,
    'Predicted Trend': predicted_trend
})

# Step 9: Calculate Prediction Accuracy
correct_predictions = sum(1 for i in range(1, len(ml_trend_indicators))
                          if ml_trend_indicators['Actual Trend'].iloc[i] == ml_trend_indicators['Predicted Trend'].iloc[i])
total_comparisons = len(ml_trend_indicators) - 1
prediction_accuracy = (correct_predictions / total_comparisons) * 100
print(f'Correct Trend Prediction Accuracy: {prediction_accuracy:.2f}%')

# Step 10: Plot the full period with predictions
plt.figure(figsize=(14, 8))
plt.plot(spy_data.index, spy_data['Close'], color='blue', label='Actual SPY Price')
plt.plot(full_results_df['Date'], full_results_df['Predicted Prices'], color='red', label='Predicted SPY Price')
plt.title(f'SPY Price Prediction with Full Date Range')
plt.xlabel('Date')
plt.ylabel('Price')
plt.xticks(rotation=45)
plt.legend()
plt.tight_layout()
plt.show()

# Step 11: Evaluate the model using RMSE for the full period
rmse_full = np.sqrt(mean_squared_error(actual_prices_full, predicted_prices_full))
print(f'Root Mean Squared Error (Full Period): {rmse_full}')

# Display the trend output
print("\nML Trend Indicators DataFrame:")
print(ml_trend_indicators.head(100))


# Initialize the pytrends API
pytrends = TrendReq(hl='en-US', tz=360)

# Define keywords related to market sentiment
keywords = ["stock market crash", "buy stocks", "sell stocks", "bull market", "bear market"]

# Build the payload and get interest over time with error handling for rate limits
try:
    pytrends.build_payload(keywords, timeframe='today 12-m', geo='US')
    trends_data = pytrends.interest_over_time()
    if 'isPartial' in trends_data.columns:
        trends_data.drop(columns=['isPartial'], inplace=True)
except Exception as e:
    print("Error fetching Google Trends data:", e)
    trends_data = pd.DataFrame()  # Empty DataFrame as fallback if rate limit is hit

# Calculate Google Trends sentiment score if data is available
if not trends_data.empty:
    trends_data['sentiment_score'] = (
        trends_data['buy stocks'] + trends_data['bull market']
    ) - (
        trends_data['sell stocks'] + trends_data['bear market'] + trends_data['stock market crash']
    )

# Download SPY and VIX data
spy_data = yf.download('SPY', start='2014-01-07', end='2024-11-07')
vix_data = yf.download('^VIX', start='2014-01-07', end='2024-11-07')

# Ensure the index of spy_data is in UTC; convert if already timezone-aware
spy_data.index = spy_data.index.tz_convert('UTC') if spy_data.index.tz else spy_data.index.tz_localize('UTC')
vix_data.index = vix_data.index.tz_convert('UTC') if vix_data.index.tz else vix_data.index.tz_localize('UTC')

# Ensure trends_data index is in UTC if data is available
if not trends_data.empty:
    trends_data.index = trends_data.index.tz_convert('UTC') if trends_data.index.tz else trends_data.index.tz_localize('UTC')
    trends_data = trends_data.reindex(spy_data.index, method='ffill')

# Align VIX data dates and forward fill missing values
vix_data = vix_data.reindex(spy_data.index, method='ffill')

# Calculate Technical Indicators
spy_data['SMA_50'] = spy_data['Close'].rolling(window=50).mean()
spy_data['SMA_200'] = spy_data['Close'].rolling(window=200).mean()

# RSI Calculation
def calculate_rsi(series, window=14):
    delta = series.diff()
    gain = delta.where(delta > 0, 0).rolling(window=window).mean()
    loss = -delta.where(delta < 0, 0).rolling(window=window).mean()
    rs = gain / loss
    return 100 - (100 / (1 + rs))

spy_data['RSI_14'] = calculate_rsi(spy_data['Close'])

# Volatility and Volume Indicators
spy_data['VIX'] = vix_data['Close']
spy_data['VPT'] = ((spy_data['Close'].pct_change()) * spy_data['Volume']).cumsum()

# Forward fill remaining NaN values
spy_data.ffill(inplace=True)

# Generate Trading Signals
def generate_signals(df, trends):
    df['Trend_Signal'] = np.where(df['SMA_50'] > df['SMA_200'], 1, -1)
    df['Momentum_Signal'] = np.where(df['RSI_14'] < 30, 1, np.where(df['RSI_14'] > 70, -1, 0))
    df['Volatility_Signal'] = np.where(df['VIX'] < 20, 1, np.where(df['VIX'] > 30, -1, 0))
    df['Volume_Signal'] = np.where(df['VPT'] > df['VPT'].shift(1), 1, -1)
    if not trends.empty:
        df['Google_Trends_Signal'] = np.where(trends['sentiment_score'] > 0, 1, -1)
    else:
        df['Google_Trends_Signal'] = 0  # Default signal if trends data is unavailable
    return df

spy_data = generate_signals(spy_data, trends_data)

# Assign Weights to Each Indicator
weights = {
    'Trend_Signal': 0.4,
    'Momentum_Signal': 0.3,
    'Volatility_Signal': 0.1,
    'Volume_Signal': 0.1,
    'Google_Trends_Signal': 0.1
}

# Calculate Combined Signal
spy_data['Combined_Signal'] = (spy_data['Trend_Signal'] * weights['Trend_Signal'] +
                               spy_data['Momentum_Signal'] * weights['Momentum_Signal'] +
                               spy_data['Volatility_Signal'] * weights['Volatility_Signal'] +
                               spy_data['Volume_Signal'] * weights['Volume_Signal'] +
                               spy_data['Google_Trends_Signal'] * weights['Google_Trends_Signal'])

spy_data['Predicted_Trend'] = np.where(spy_data['Combined_Signal'] > 0, 'Uptrend', 'Downtrend')
spy_data['Actual_Trend'] = np.where(spy_data['Close'] > spy_data['Close'].shift(1), 'Uptrend', 'Downtrend')

# Calculate Success Rates
def calculate_success_rate(signal, actual_trend):
    signal_trend = np.where(signal > 0, 'Uptrend', 'Downtrend')
    correct_predictions = np.sum(signal_trend == actual_trend)
    total_predictions = len(actual_trend)
    return (correct_predictions / total_predictions) * 100

success_rates = {
    "Trend": calculate_success_rate(spy_data['Trend_Signal'], spy_data['Actual_Trend']),
    "Momentum": calculate_success_rate(spy_data['Momentum_Signal'], spy_data['Actual_Trend']),
    "Volatility": calculate_success_rate(spy_data['Volatility_Signal'], spy_data['Actual_Trend']),
    "Volume": calculate_success_rate(spy_data['Volume_Signal'], spy_data['Actual_Trend']),
    "Google Trends": calculate_success_rate(spy_data['Google_Trends_Signal'], spy_data['Actual_Trend']),
    "Combined": calculate_success_rate(spy_data['Combined_Signal'], spy_data['Actual_Trend'])
}

# Display Success Rates
for indicator, rate in success_rates.items():
    print(f"{indicator} Indicator Success Rate: {rate:.2f}%")
    print('Current trend in the market is ',spy_data['Predicted_Trend'].iloc[-1])

# Plotting Code
plt.figure(figsize=(14, 8))
plt.plot(spy_data['Close'], label='SPY Price', color='black')
plt.plot(spy_data['SMA_50'], label='SMA 50', color='blue')
plt.plot(spy_data['SMA_200'], label='SMA 200', color='red')
plt.title(f'Trend Indicator (SMA) - Success Rate: {success_rates["Trend"]:.2f}%')
plt.legend()
plt.show()

plt.figure(figsize=(14, 8))
plt.plot(spy_data['RSI_14'], label='RSI 14', color='green')
plt.axhline(30, linestyle='--', color='red', label='Oversold (30)')
plt.axhline(70, linestyle='--', color='red', label='Overbought (70)')
plt.title(f'Momentum Indicator (RSI) - Success Rate: {success_rates["Momentum"]:.2f}%')
plt.legend()
plt.show()

plt.figure(figsize=(14, 8))
plt.plot(spy_data['VIX'], label='VIX', color='purple')
plt.axhline(20, linestyle='--', color='green', label='Low Volatility (20)')
plt.axhline(30, linestyle='--', color='red', label='High Volatility (30)')
plt.title(f'Volatility Indicator (VIX) - Success Rate: {success_rates["Volatility"]:.2f}%')
plt.legend()
plt.show()

plt.figure(figsize=(14, 8))
plt.plot(spy_data['VPT'], label='Volume Price Trend (VPT)', color='orange')
plt.title(f'Volume Indicator (VPT) - Success Rate: {success_rates["Volume"]:.2f}%')
plt.legend()
plt.show()

if not trends_data.empty:
    plt.figure(figsize=(14, 8))
    plt.plot(trends_data.index, trends_data['sentiment_score'], label='Google Trends Sentiment Score', color='blue')
    plt.title(f'Google Trends Indicator - Success Rate: {success_rates["Google Trends"]:.2f}%')
    plt.legend()
    plt.show()

plt.figure(figsize=(14, 8))
plt.plot(spy_data.index, spy_data['Close'], label='SPY Price', color='black')
plt.scatter(spy_data.index[spy_data['Predicted_Trend'] == 'Uptrend'], spy_data['Close'][spy_data['Predicted_Trend'] == 'Uptrend'], color='green', label='Predicted Uptrend', marker='^', alpha=0.7)
plt.scatter(spy_data.index[spy_data['Predicted_Trend'] == 'Downtrend'], spy_data['Close'][spy_data['Predicted_Trend'] == 'Downtrend'], color='red', label='Predicted Downtrend', marker='v', alpha=0.7)
plt.title(f'Actual vs Predicted Trends - Combined Success Rate: {success_rates["Combined"]:.2f}%')
plt.legend()
