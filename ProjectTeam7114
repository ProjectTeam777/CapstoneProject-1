# Initialize trading variables
initial_capital = 100000  # Starting capital
capital = initial_capital
position = 0  # 1 for long (holding stock), -1 for short position, 0 for no position
entry_price = 0.0
buy_dates, sell_dates, profits = [], [], []
entry_prices, exit_prices, vix_values = [], [], []
max_hold_days = 5  # Maximum hold period
hold_day_count = 0  # Counter to track the number of days a position is held

# Define the base stop-loss threshold
base_stop_loss_threshold = 0.02  # 2% base stop-loss
volatility_threshold = 25  # Volatility level at which stop-loss is adjusted

# Initialize capital tracking lists for plotting
strategy_capital_values = [initial_capital]

# Run the strategy with entry/exit conditions of uptrend and downtrend
for i in range(1, len(ml_trend_indicators)):
    ml_trend = ml_trend_indicators['Predicted Trend'].iloc[i]
    ta_trend = spy_data['Predicted_Trend'].iloc[i]
    current_price = spy_data['Close'].iloc[i].item()  # Ensure current_price is a float
    current_vix = spy_data['VIX'].iloc[i].item()      # Ensure current_vix is a float

    # Calculate dynamic stop-loss threshold based on VIX
    dynamic_stop_loss_threshold = base_stop_loss_threshold * (current_vix / volatility_threshold)

    # Buy condition: ML or TA trend indicates an Uptrend, and no open position
    if (ml_trend == 'Uptrend' or ta_trend == 'Uptrend') and position == 0:
        position = 1  # Enter a long position
        entry_price = current_price
        buy_dates.append(spy_data.index[i])  # Record buy date
        entry_prices.append(entry_price)  # Store entry price
        vix_values.append(current_vix)  # Store VIX level
        hold_day_count = 0  # Reset hold day count
        print(f"Bought at {entry_price} on {spy_data.index[i]} with VIX: {current_vix:.2f}%")

    # Sell condition: ML or TA trend indicates a Downtrend, max hold days reached, or stop-loss triggered
    elif position == 1:
        # Check for stop-loss condition
        if current_price <= entry_price * (1 - dynamic_stop_loss_threshold):
            profit = ((current_price - entry_price) / entry_price) * 100  # Profit as percentage
            capital *= (1 + profit / 100)  # Update capital
            position = 0  # Close position
            profits.append(profit)  # Record profit percentage
            sell_dates.append(spy_data.index[i])  # Record sell date
            exit_prices.append(current_price)  # Store exit price
            print(f"Stop-loss triggered: Sold at {current_price} on {spy_data.index[i]} with profit: {profit:.2f}%")

        # Sell based on downtrend or max hold days
        elif (ml_trend == 'Downtrend' or ta_trend == 'Downtrend' or hold_day_count >= max_hold_days):
            profit = ((current_price - entry_price) / entry_price) * 100  # Profit as percentage
            capital *= (1 + profit / 100)  # Update capital
            position = 0  # Close position
            profits.append(profit)  # Record profit percentage
            sell_dates.append(spy_data.index[i])  # Record sell date
            exit_prices.append(current_price)  # Store exit price
            print(f"Sold at {current_price} on {spy_data.index[i]} with profit: {profit:.2f}%")

        # Increment hold day counter if in a position
        if position == 1:
            hold_day_count += 1

    # Track capital over time for strategy
    strategy_capital_values.append(capital)

# Ensure equal length lists by adding placeholders if there is an open position left
if len(buy_dates) > len(sell_dates):
    sell_dates.append(None)
    exit_prices.append(None)
    profits.append(None)

# Calculate total percentage return from the strategy
total_strategy_return = ((capital - initial_capital) / initial_capital) * 100
print(f"Total Strategy Return: {total_strategy_return:.2f}%")

# Calculate return from simply holding the stock from start to end date
start_price = spy_data['Close'].iloc[0].item()  # Ensure start_price is a float
end_price = spy_data['Close'].iloc[-1].item()   # Ensure end_price is a float
total_stock_return = ((end_price - start_price) / start_price) * 100
print(f"Total Stock Return (Buy and Hold): {total_stock_return:.2f}%")

# Store results in a DataFrame and save to CSV
trades_df = pd.DataFrame({
    'Buy Date': buy_dates,
    'Sell Date': sell_dates,
    'Entry Price': entry_prices,
    'Exit Price': exit_prices,
    'VIX at Entry': vix_values,
    'Profit (%)': profits
})
trades_df.to_csv('trading_strategy_results.csv', index=False)
print("Trading results saved to 'trading_strategy_results.csv'.")

